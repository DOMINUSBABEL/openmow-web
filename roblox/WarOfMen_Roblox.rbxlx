		startMp = 430,
		flags = {
			{ id = "flag_west", name = "Red Banner Rail Yard", pos = Vector3.new(-95, 0, 20), initialOwner = 0 },
			{ id = "flag_center", name = "Dzerzhinsky Square", pos = Vector3.new(0, 0, 0), initialOwner = -1 },

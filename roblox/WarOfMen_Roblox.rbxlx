				<Properties>
					<string name="Name">SyncPlayerProfile</string>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX_SHARED">
			<Properties>
				<string name="Name">Shared</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX_MOD_CATALOG">
				<Properties>
					<string name="Name">WarOfMenCatalog</string>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	WarOfMenCatalog.luau
	Catálogo maestro de "War of Men" (Roblox Port de OpenMoW-Web / Men of War: Assault Squad 2).
	Contiene:
	  1. Las 5 Facciones Históricas (USA, GER, ENG, RUS, JAP)
	  2. Las 15 Escaramuzas Tácticas / Mapas con biomas, banderas y fortificaciones
	  3. Tablas Balísticas GEM2 (Armas ligeras, ametralladoras, cohetes AT y cañones de tanque)
	  4. Perfiles de Unidades (Infantería articulada y Blindados con blindaje F/S/R/T)
	  5. Las 20 Escuadras y Blindados desplegables por Puntos de Mando (MP)
]]

local WarOfMenCatalog = {}

export type FactionId = "USA" | "GER" | "ENG" | "RUS" | "JAP"

export type FactionDef = {
	id: FactionId,
	name: string,
	shortName: string,
	doctrine: string,
	flagEmoji: string,
	primaryColor: Color3,
	accentColor: Color3,
	uniformColor: Color3,
	helmetColor: Color3,
	tankColor: Color3,
}


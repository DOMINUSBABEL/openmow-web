		flags = {
			{ id = "flag_west", name = "Suribachi Pillbox Network", pos = Vector3.new(-95, 0, 12), initialOwner = 0 },
			{ id = "flag_center", name = "Black Sand Runway No.1", pos = Vector3.new(0, 0, 0), initialOwner = -1 },
			{ id = "flag_east", name = "Beachhead Amtrac Depot", pos = Vector3.new(95, 0, -12), initialOwner = 1 },

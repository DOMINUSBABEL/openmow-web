		startMp = 390,
		flags = {
			{ id = "flag_west", name = "Jungle Trail Assembly", pos = Vector3.new(-95, 0, -18), initialOwner = 0 },
			{ id = "flag_center", name = "Lunga River Bamboo Bridge", pos = Vector3.new(0, 0, 0), initialOwner = -1 },
			{ id = "flag_east", name = "Henderson Field Perimeter", pos = Vector3.new(95, 0, 18), initialOwner = 1 },
		},
	},
}

function WarOfMenCatalog.getMissionById(missionId: string): MissionDef
	for _, m in ipairs(WarOfMenCatalog.MISSIONS) do
		if m.id == missionId then
			return m
		end
	end
	return WarOfMenCatalog.MISSIONS[1]
end

function WarOfMenCatalog.getReinforcementsForFaction(faction: FactionId): { ReinforcementDef }
	local out = {}
	for _, r in ipairs(WarOfMenCatalog.REINFORCEMENTS) do
		if r.faction == faction then
			table.insert(out, r)
		end
	end
	return out
end

function WarOfMenCatalog.getPenetrationAtDistance(weapon: WeaponDef, distStuds: number): number
	local p = weapon.penetration
	-- En nuestro campo de batalla 1 metro ≈ 2.2 studs
	local distMeters = math.max(1, distStuds / 2.2)
	if distMeters <= 10 then
		return p.d10
	elseif distMeters <= 50 then
		local t = (distMeters - 10) / 40
		return p.d10 + (p.d50 - p.d10) * t
	elseif distMeters <= 100 then
		local t = (distMeters - 50) / 50
		return p.d50 + (p.d100 - p.d50) * t
	else
		local t = math.clamp((distMeters - 100) / 100, 0, 1)
		return p.d100 + (p.d200 - p.d100) * t
	end
end

return WarOfMenCatalog
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX_MOD_NET">
				<Properties>
					<string name="Name">NetProtocol</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
--[[
	NetProtocol.luau
	Protocolo de comunicación Cliente <-> Servidor para "War of Men" (Roblox Engine).
	Soporta tanto servidores en vivo / Play Mode (RemoteEvent) como ejecución
	interactiva en vivo dentro del visor de Roblox Studio Edit Mode (BindableEvent StudioBus).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NetProtocol = {}

NetProtocol.FOLDER_NAME = "WarOfMenRemotes"
NetProtocol.BUS_FOLDER_NAME = "WarOfMenStudioBus"

NetProtocol.EVENTS = {
	-- Órdenes del Jugador (Client -> Server)
	IssueMoveOrder = "IssueMoveOrder",
	IssueAttackOrder = "IssueAttackOrder",
	SetPostureOrder = "SetPostureOrder",
	SetFireModeOrder = "SetFireModeOrder",
	CallReinforcementOrder = "CallReinforcementOrder",
	SelectMissionOrder = "SelectMissionOrder",
	ToggleBotModeOrder = "ToggleBotModeOrder",
	DirectControlFireOrder = "DirectControlFireOrder",
	DirectControlMoveOrder = "DirectControlMoveOrder",
	ResetSkirmishOrder = "ResetSkirmishOrder",

	-- Difusión del Servidor (Server -> Client)
	SyncBattleState = "SyncBattleState",
	CombatShotBroadcast = "CombatShotBroadcast",
	BattleBannerBroadcast = "BattleBannerBroadcast",
	SyncPlayerProfile = "SyncPlayerProfile",
}

function NetProtocol.isStudioEdit(): boolean
	local ok, res = pcall(function()
		return RunService:IsStudio() and not RunService:IsRunning()
	end)
	return ok and res == true
end

function NetProtocol.ensureRemotesFolder(): Folder
	local folder = ReplicatedStorage:FindFirstChild(NetProtocol.FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = NetProtocol.FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, evName in pairs(NetProtocol.EVENTS) do
		if not folder:FindFirstChild(evName) then
			local re = Instance.new("RemoteEvent")
			re.Name = evName
			re.Parent = folder
		end
	end
	return folder
end

function NetProtocol.ensureStudioBusFolder(): Folder
	local folder = ReplicatedStorage:FindFirstChild(NetProtocol.BUS_FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = NetProtocol.BUS_FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, evName in pairs(NetProtocol.EVENTS) do
		if not folder:FindFirstChild(evName) then
			local be = Instance.new("BindableEvent")
			be.Name = evName
			be.Parent = folder
		end
	end
	return folder
end

function NetProtocol.getEvent(eventName: string): RemoteEvent
	local folder = NetProtocol.ensureRemotesFolder()
	local ev = folder:FindFirstChild(eventName)
	if not ev then
		ev = Instance.new("RemoteEvent")
		ev.Name = eventName
		ev.Parent = folder
	end
	return ev
end

function NetProtocol.getBusEvent(eventName: string): BindableEvent
	local folder = NetProtocol.ensureStudioBusFolder()
	local be = folder:FindFirstChild(eventName)
	if not be then
		be = Instance.new("BindableEvent")
		be.Name = eventName
		be.Parent = folder
	end
	return be
end

-- Helper universal para enviar desde el Cliente al Servidor
function NetProtocol.fireServer(eventName: string, payload: any)
	if NetProtocol.isStudioEdit() then
		NetProtocol.getBusEvent(eventName):Fire(nil, payload)
	else
		NetProtocol.getEvent(eventName):FireServer(payload)
	end
end

-- Helper universal para escuchar en el Servidor eventos del Cliente
function NetProtocol.onServerEvent(eventName: string, callback: (Player?, any) -> ())
	if NetProtocol.isStudioEdit() then
		NetProtocol.getBusEvent(eventName).Event:Connect(callback)
	else
		NetProtocol.getEvent(eventName).OnServerEvent:Connect(callback)
	end
end

-- Helper universal para enviar desde el Servidor a todos los Clientes
function NetProtocol.fireAllClients(eventName: string, payload: any)
	if NetProtocol.isStudioEdit() then
		NetProtocol.getBusEvent(eventName):Fire(payload)
	else
		NetProtocol.getEvent(eventName):FireAllClients(payload)
	end
end

-- Helper universal para enviar desde el Servidor a un Cliente específico
function NetProtocol.fireClient(eventName: string, player: Player?, payload: any)
	if NetProtocol.isStudioEdit() then
		NetProtocol.getBusEvent(eventName):Fire(payload)
	elseif player then
		NetProtocol.getEvent(eventName):FireClient(player, payload)
	end
end

-- Helper universal para escuchar en el Cliente eventos del Servidor
function NetProtocol.onClientEvent(eventName: string, callback: (any) -> ())
	if NetProtocol.isStudioEdit() then
		NetProtocol.getBusEvent(eventName).Event:Connect(callback)
	else
		NetProtocol.getEvent(eventName).OnClientEvent:Connect(callback)
	end
end

return NetProtocol
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX_SSS">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX_SRV_PROFILE">
			<Properties>
				<string name="Name">ProfileStoreService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileStoreService.luau
	Persistencia de Comandante en DataStoreService ("WarOfMen_CommanderProfile_v1")
	con fallback en memoria para sesiones en Roblox Studio sin API de terceros.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NetProtocol = require(Shared:WaitForChild("NetProtocol"))

local ProfileStoreService = {}

export type CommanderProfile = {
	userId: number,
	rankLevel: number,
	rankTitle: string,
	xp: number,
	victories: number,
	infantryEliminated: number,
	armorDestroyed: number,
	flagsCaptured: number,
}

local RANKS = {
	{ level = 1, xp = 0, title = "2nd Lieutenant" },
	{ level = 2, xp = 300, title = "1st Lieutenant" },
	{ level = 3, xp = 800, title = "Captain" },
	{ level = 4, xp = 1600, title = "Major" },
	{ level = 5, xp = 2800, title = "Lieutenant Colonel" },
	{ level = 6, xp = 4500, title = "Colonel" },
	{ level = 7, xp = 7000, title = "Brigadier General" },
	{ level = 8, xp = 11000, title = "Major General" },
	{ level = 9, xp = 17000, title = "Field Marshal" },
}

local profiles: { [number]: CommanderProfile } = {}
local store: GlobalDataStore? = nil

pcall(function()
	store = DataStoreService:GetDataStore("WarOfMen_CommanderProfile_v1")
end)

local function computeRank(xp: number): (number, string)
	local lvl = 1
	local title = "2nd Lieutenant"
	for _, r in ipairs(RANKS) do
		if xp >= r.xp then
			lvl = r.level
			title = r.title
		end
	end
	return lvl, title
end

function ProfileStoreService.getProfile(userId: number): CommanderProfile
	if profiles[userId] then
		return profiles[userId]
	end
	local defaultProfile: CommanderProfile = {
		userId = userId,
		rankLevel = 1,
		rankTitle = "2nd Lieutenant",
		xp = 0,
		victories = 0,
		infantryEliminated = 0,
		armorDestroyed = 0,
		flagsCaptured = 0,
	}
	if store and userId > 0 then
		local ok, saved = pcall(function()
			return store:GetAsync("cmd_" .. tostring(userId))
		end)
		if ok and type(saved) == "table" then
			defaultProfile.xp = tonumber(saved.xp) or 0
			defaultProfile.victories = tonumber(saved.victories) or 0
			defaultProfile.infantryEliminated = tonumber(saved.infantryEliminated) or 0
			defaultProfile.armorDestroyed = tonumber(saved.armorDestroyed) or 0
			defaultProfile.flagsCaptured = tonumber(saved.flagsCaptured) or 0
			local lvl, title = computeRank(defaultProfile.xp)
			defaultProfile.rankLevel = lvl
			defaultProfile.rankTitle = title
		end
	end
	profiles[userId] = defaultProfile
	return defaultProfile
end

function ProfileStoreService.addStats(
	player: Player?,
	xpDelta: number,
	killsDelta: number,
	armorDelta: number,
	flagsDelta: number,
	victoryDelta: number
)
	local uid = if player then player.UserId else 0
	local p = ProfileStoreService.getProfile(uid)
	p.xp += xpDelta
	p.infantryEliminated += killsDelta
	p.armorDestroyed += armorDelta
	p.flagsCaptured += flagsDelta
	p.victories += victoryDelta
	local lvl, title = computeRank(p.xp)
	p.rankLevel = lvl
	p.rankTitle = title

	NetProtocol.fireClient(NetProtocol.EVENTS.SyncPlayerProfile, player, p)
end

function ProfileStoreService.saveProfile(userId: number)
	local p = profiles[userId]
	if not p or not store or userId <= 0 then
		return
	end
	pcall(function()
		store:SetAsync("cmd_" .. tostring(userId), p)
	end)
end

return ProfileStoreService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_SRV_BALLISTICS">
			<Properties>
				<string name="Name">BallisticsCombatService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	BallisticsCombatService.luau
	Motor balístico GEM2 en servidor para "War of Men":
	  - Curvas de penetración por distancia (10m, 50m, 100m, 200m)
	  - Blindaje direccional (Front / Side / Rear / Top)
	  - Cálculo de ángulo de incidencia y rebote automático a >= 70° (RICOCHET)
	  - Modificadores de postura (stand / crouch / prone) y cobertura táctica
	  - Daño en área HE (High Explosive) de artillería, tanques y cohetes AT
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WarOfMenCatalog = require(Shared:WaitForChild("WarOfMenCatalog"))

local BallisticsCombatService = {}

export type ShotResult = {
	shooterId: number,
	targetId: number,
	weaponId: string,
	fromPos: Vector3,
	toPos: Vector3,
	outcome: "HIT" | "MISS" | "PENETRATED" | "PARTIAL" | "BOUNCED" | "RICOCHET",
	armorFace: "FRONT" | "SIDE" | "REAR" | "BODY",
	impactAngleDeg: number,
	penetrationMm: number,
	effectiveArmorMm: number,
	damageDealt: number,
	targetDestroyed: boolean,
	heRadius: number,
}

function BallisticsCombatService.resolveShot(
	shooter: any,
	target: any,
	weapon: WarOfMenCatalog.WeaponDef,
	allUnits: { [number]: any }
): (ShotResult, { { unit: any, splashDamage: number } })
	local fromPos: Vector3 = shooter.pos + Vector3.new(0, if shooter.kind == "vehicle" then 3.6 else 2.6, 0)
	local targetHeight = if target.kind == "vehicle"
		then 2.8
		elseif target.posture == "prone" then 0.9
		elseif target.posture == "crouch" then 1.8
		else 2.7
	local toPos: Vector3 = target.pos + Vector3.new(0, targetHeight, 0)
	local delta = toPos - fromPos
	local distStuds = math.max(1, delta.Magnitude)

	local splashHits: { { unit: any, splashDamage: number } } = {}

	if target.kind == "vehicle" and target.armor then
		-- Arma ligera sin penetración suficiente contra blindados
		local penMm = WarOfMenCatalog.getPenetrationAtDistance(weapon, distStuds) * (0.92 + math.random() * 0.16)
		local incVec = Vector3.new(fromPos.X - toPos.X, 0, fromPos.Z - toPos.Z)
		if incVec.Magnitude < 0.01 then
			incVec = Vector3.new(0, 0, 1)
		else
			incVec = incVec.Unit
		end

		local yaw = target.yaw or 0
		local fwd = Vector3.new(math.sin(yaw), 0, math.cos(yaw))
		local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))

		local dotFwd = fwd:Dot(incVec)
		local armorFace: "FRONT" | "SIDE" | "REAR" = "SIDE"
		local baseArmor = target.armor.side
		local normalVec = right

		if dotFwd > 0.52 then
			armorFace = "FRONT"
			baseArmor = target.armor.front
			normalVec = fwd
		elseif dotFwd < -0.52 then
			armorFace = "REAR"
			baseArmor = target.armor.rear
			normalVec = -fwd
		else
			armorFace = "SIDE"
			baseArmor = target.armor.side
			normalVec = if right:Dot(incVec) >= 0 then right else -right
		end

		local cosTheta = math.clamp(math.abs(normalVec:Dot(incVec)), 0.08, 1.0)
		local angleDeg = math.floor(math.deg(math.acos(cosTheta)) + 0.5)
		local effectiveArmor = math.floor((baseArmor / cosTheta) + 0.5)

		local outcome: "PENETRATED" | "PARTIAL" | "BOUNCED" | "RICOCHET" = "BOUNCED"
		local damage = 0

		if weapon.category == "small_arms" or weapon.category == "mg" then
			outcome = "BOUNCED"
			damage = 0
		elseif angleDeg >= 70 then
			outcome = "RICOCHET"
			damage = 0
		elseif penMm >= effectiveArmor then
			outcome = "PENETRATED"
			damage = math.floor(weapon.damage * (0.92 + math.random() * 0.22))
		elseif penMm >= effectiveArmor * 0.78 then
			outcome = "PARTIAL"
			damage = math.floor(weapon.damage * 0.30)
		else
			outcome = "BOUNCED"
			damage = 0
		end

		local result: ShotResult = {
			shooterId = shooter.id,
			targetId = target.id,
			weaponId = weapon.id,
			fromPos = fromPos,
			toPos = toPos,
			outcome = outcome,
			armorFace = armorFace,
			impactAngleDeg = angleDeg,
			penetrationMm = math.floor(penMm + 0.5),
			effectiveArmorMm = effectiveArmor,
			damageDealt = damage,
			targetDestroyed = false,
			heRadius = weapon.heRadius,
		}
		return result, splashHits
	else
		-- Disparo contra Infantería
		local postureMult = 1.0
		local hitProb = 0.76
		if target.posture == "crouch" then
			postureMult = 0.76
			hitProb = 0.56
		elseif target.posture == "prone" then
			postureMult = 0.52
			hitProb = 0.38
		end

		if target.inCover then
			hitProb *= 0.68
			postureMult *= 0.75
		end

		-- Penalización por distancia
		local distRatio = math.clamp(distStuds / math.max(40, weapon.range), 0, 1.15)
		hitProb = math.clamp(hitProb * (1.12 - distRatio * 0.48), 0.16, 0.92)

		local outcome: "HIT" | "MISS" = "MISS"
		local damage = 0

		if math.random() <= hitProb or weapon.heRadius > 0 then
			outcome = "HIT"
			local rawDmg = if weapon.heDamage > 0 then weapon.heDamage else weapon.damage
			damage = math.max(6, math.floor(rawDmg * postureMult * (0.88 + math.random() * 0.24)))
		else
			-- Desvío visual del trazador en caso de fallo
			toPos = toPos + Vector3.new((math.random() - 0.5) * 4.5, (math.random() - 0.3) * 2.2, (math.random() - 0.5) * 4.5)
		end

		-- Daño HE en área (cañones y cohetes AT contra escuadras)
		if weapon.heRadius > 0 then
			for _, other in pairs(allUnits) do
				if other.id ~= target.id and other.hp > 0 and other.team ~= shooter.team and other.kind == "infantry" then
					local d = (other.pos - target.pos).Magnitude
					if d <= weapon.heRadius then
						local falloff = 1 - (d / (weapon.heRadius + 1))
						local sDmg = math.max(8, math.floor(weapon.heDamage * falloff * 0.75))
						table.insert(splashHits, { unit = other, splashDamage = sDmg })
					end
				end
			end
		end

		local result: ShotResult = {
			shooterId = shooter.id,
			targetId = target.id,
			weaponId = weapon.id,
			fromPos = fromPos,
			toPos = toPos,
			outcome = outcome,
			armorFace = "BODY",
			impactAngleDeg = 0,
			penetrationMm = weapon.penetration.d50,
			effectiveArmorMm = 0,
			damageDealt = damage,
			targetDestroyed = false,
			heRadius = weapon.heRadius,
		}
		return result, splashHits
	end
end

return BallisticsCombatService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_SRV_WORLDSIM">
			<Properties>
				<string name="Name">WorldSimService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	WorldSimService.luau
	Motor de Simulación Táctica Determinista (20 Hz) en Servidor para "War of Men".
	Construye el escenario 3D en Workspace.WarOfMenBattlefield, instancia modelos 3D
	articulados de infantería y tanques con torreta móvil, gestiona movimiento, posturas,
	cobertura tras sacos terreros, captura de banderas, puntos de mando (MP) y combate.
]]

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local ServerScriptService = game:GetService("ServerScriptService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WarOfMenCatalog = require(Shared:WaitForChild("WarOfMenCatalog"))
local NetProtocol = require(Shared:WaitForChild("NetProtocol"))
local BallisticsCombatService = require(ServerScriptService:WaitForChild("BallisticsCombatService"))
local ProfileStoreService = require(ServerScriptService:WaitForChild("ProfileStoreService"))

local WorldSimService = {}

export type UnitEntity = {
	id: number,
	templateId: string,
	name: string,
	team: number, -- 0 = Allied/Player, 1 = Axis/Enemy
	faction: WarOfMenCatalog.FactionId,
	kind: "infantry" | "vehicle",
	role: string,
	hp: number,
	maxHp: number,
	speed: number,
	pos: Vector3,
	targetPos: Vector3?,
	yaw: number,
	turretYaw: number,
	posture: "stand" | "crouch" | "prone",
	fireMode: "free" | "hold" | "return",
	inCover: boolean,
	weaponId: string,
	secondaryWeaponId: string?,
	cooldownTimer: number,
	secondaryCooldown: number,
	targetUnitId: number?,
	armor: WarOfMenCatalog.ArmorProfile?,
	veterancy: number,
	kills: number,
	model: Model?,
	walkCycle: number,
	directControlUntil: number,
	hasExplicitOrder: boolean,
	hasExplicitTarget: boolean,
}

export type FlagState = {
	id: string,
	name: string,
	pos: Vector3,
	owner: number, -- -1 neutral, 0 team0, 1 team1
	captureProgress: number, -- -100 (team1) to +100 (team0)
	model: Model?,
}

-- Estado Maestro de la Partida
WorldSimService.currentMissionId = "usa_normandy"
WorldSimService.missionDef = WarOfMenCatalog.getMissionById("usa_normandy")
WorldSimService.tickCount = 0
WorldSimService.elapsedTime = 0
WorldSimService.nextUnitId = 1
WorldSimService.units = {} :: { [number]: UnitEntity }
WorldSimService.flags = {} :: { FlagState }
WorldSimService.coverPositions = {} :: { Vector3 }
WorldSimService.teamMp = { [0] = 380, [1] = 380 }
WorldSimService.teamVp = { [0] = 500, [1] = 500 }
WorldSimService.reinfCooldowns = { [0] = {} :: { [string]: number }, [1] = {} :: { [string]: number } }
WorldSimService.playerBotMode = "OFF" :: "OFF" | "DEFEND" | "ATTACK"
WorldSimService.matchOver = false
WorldSimService.winnerTeam = -1

local rootFolder: Folder? = nil
local mapFolder: Folder? = nil
local unitsFolder: Folder? = nil
local flagsFolder: Folder? = nil
local wrecksFolder: Folder? = nil

local function makePart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, canCollide: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.CanCollide = if canCollide ~= nil then canCollide else true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function WorldSimService.ensureContainers()
	local bf = Workspace:FindFirstChild("WarOfMenBattlefield")
	if not bf then
		bf = Instance.new("Folder")
		bf.Name = "WarOfMenBattlefield"
		bf.Parent = Workspace
	end
	rootFolder = bf :: Folder

	local function ensureSub(name: string): Folder
		local f = (bf :: Folder):FindFirstChild(name)
		if not f then
			f = Instance.new("Folder")
			f.Name = name
			f.Parent = bf
		end
		return f :: Folder
	end

	mapFolder = ensureSub("MapGeometry")
	unitsFolder = ensureSub("Units")
	flagsFolder = ensureSub("Flags")
	wrecksFolder = ensureSub("Wrecks")
end

function WorldSimService.buildBattlefieldGeometry(mission: WarOfMenCatalog.MissionDef)
	WorldSimService.ensureContainers()
	if not mapFolder or not flagsFolder then
		return
	end
	mapFolder:ClearAllChildren()
	flagsFolder:ClearAllChildren()
	table.clear(WorldSimService.coverPositions)
	table.clear(WorldSimService.flags)

	-- Iluminación atmosférica según el teatro de operaciones
	pcall(function()
		Lighting.Ambient = mission.ambientColor
		Lighting.OutdoorAmbient = mission.ambientColor
		Lighting.Brightness = 2.4
		Lighting.ClockTime = if mission.id == "eng_pegasus" then 5.8 else 14.5
	end)

	local groundMat = Enum.Material.Grass
	if mission.biome == "winter" or mission.biome == "winter_urban" then
		groundMat = Enum.Material.Snow
	elseif mission.biome == "desert" then
		groundMat = Enum.Material.Sand
	elseif mission.biome == "urban" then
		groundMat = Enum.Material.Cobblestone
	elseif mission.biome == "volcanic" then
		groundMat = Enum.Material.Basalt
	end

	-- Suelo Táctico Principal (320 x 220 studs)
	makePart(mapFolder, "TacticalGround", Vector3.new(340, 4, 240), CFrame.new(0, -2, 0), mission.groundColor, groundMat, true)

	-- Canal / Río Táctico Norte-Sur con Vados y Puente Central
	makePart(mapFolder, "RiverChannel", Vector3.new(26, 1.5, 236), CFrame.new(0, -0.6, 0), mission.waterColor, Enum.Material.Water, false)
	-- Puente Central de Piedra/Acero
	makePart(mapFolder, "CentralBridgeDeck", Vector3.new(34, 1.4, 26), CFrame.new(0, 0.3, 0), mission.roadColor, Enum.Material.Concrete, true)
	makePart(mapFolder, "BridgeParapetNorth", Vector3.new(34, 2.6, 1.8), CFrame.new(0, 1.6, -12.5), Color3.fromRGB(95, 98, 102), Enum.Material.Concrete, true)
	makePart(mapFolder, "BridgeParapetSouth", Vector3.new(34, 2.6, 1.8), CFrame.new(0, 1.6, 12.5), Color3.fromRGB(95, 98, 102), Enum.Material.Concrete, true)

	-- Vados laterales Norte y Sur para flanqueos
	makePart(mapFolder, "NorthFordCrossing", Vector3.new(30, 0.9, 20), CFrame.new(0, -0.1, -68), mission.roadColor, Enum.Material.Slate, true)
	makePart(mapFolder, "SouthFordCrossing", Vector3.new(30, 0.9, 20), CFrame.new(0, -0.1, 68), mission.roadColor, Enum.Material.Slate, true)

	-- Carretera Este-Oeste
	makePart(mapFolder, "MainRoadWest", Vector3.new(145, 0.3, 18), CFrame.new(-88, 0.1, 0), mission.roadColor, Enum.Material.Cobblestone, true)
	makePart(mapFolder, "MainRoadEast", Vector3.new(145, 0.3, 18), CFrame.new(88, 0.1, 0), mission.roadColor, Enum.Material.Cobblestone, true)

	-- Búnkeres de Hormigón y Trincheras en ambos frentes
	local bunkerLocations = {
		{ pos = Vector3.new(-76, 0, -34), yaw = 0 },
		{ pos = Vector3.new(-76, 0, 34), yaw = 0 },
		{ pos = Vector3.new(76, 0, -34), yaw = math.pi },
		{ pos = Vector3.new(76, 0, 34), yaw = math.pi },
	}
	for idx, b in ipairs(bunkerLocations) do
		local bModel = Instance.new("Model")
		bModel.Name = "ConcreteBunker_" .. tostring(idx)
		bModel.Parent = mapFolder
		local baseCf = CFrame.new(b.pos) * CFrame.Angles(0, b.yaw, 0)
		makePart(bModel, "BunkerFloor", Vector3.new(16, 0.6, 14), baseCf * CFrame.new(0, 0.3, 0), Color3.fromRGB(108, 110, 114), Enum.Material.Concrete, true)
		makePart(bModel, "BunkerWallFrontLow", Vector3.new(2.2, 2.4, 14), baseCf * CFrame.new(7, 1.2, 0), Color3.fromRGB(96, 98, 102), Enum.Material.Concrete, true)
		makePart(bModel, "BunkerWallNorth", Vector3.new(16, 5.5, 2.0), baseCf * CFrame.new(0, 2.75, -6), Color3.fromRGB(92, 94, 98), Enum.Material.Concrete, true)
		makePart(bModel, "BunkerWallSouth", Vector3.new(16, 5.5, 2.0), baseCf * CFrame.new(0, 2.75, 6), Color3.fromRGB(92, 94, 98), Enum.Material.Concrete, true)
		makePart(bModel, "BunkerRoof", Vector3.new(17, 1.2, 15), baseCf * CFrame.new(0, 6.0, 0), Color3.fromRGB(82, 85, 88), Enum.Material.Concrete, true)
		table.insert(WorldSimService.coverPositions, b.pos)
	end

	-- Líneas de Sacos Terreros (Cobertura Táctica Real)
	local sandbagPositions = {
		Vector3.new(-46, 0, -24),
		Vector3.new(-46, 0, 24),
		Vector3.new(-24, 0, -48),
		Vector3.new(-24, 0, 48),
		Vector3.new(46, 0, -24),
		Vector3.new(46, 0, 24),
		Vector3.new(24, 0, -48),
		Vector3.new(24, 0, 48),
		Vector3.new(-92, 0, -16),
		Vector3.new(92, 0, 16),
	}
	for idx, sPos in ipairs(sandbagPositions) do
		makePart(
			mapFolder,
			"SandbagWall_" .. tostring(idx),
			Vector3.new(3.2, 2.3, 11.5),
			CFrame.new(sPos + Vector3.new(0, 1.15, 0)),
			Color3.fromRGB(174, 154, 112),
			Enum.Material.Sand,
			true
		)
		table.insert(WorldSimService.coverPositions, sPos)
	end

	-- Erizos Checos Antitanque y Árboles del Bioma
	local treePositions = {
		Vector3.new(-62, 0, -68), Vector3.new(-35, 0, -78), Vector3.new(35, 0, -78), Vector3.new(62, 0, -68),
		Vector3.new(-62, 0, 68), Vector3.new(-35, 0, 78), Vector3.new(35, 0, 78), Vector3.new(62, 0, 68),
		Vector3.new(-118, 0, -45), Vector3.new(-118, 0, 45), Vector3.new(118, 0, -45), Vector3.new(118, 0, 45),
	}
	local foliageColor = if mission.biome == "winter" or mission.biome == "winter_urban"
		then Color3.fromRGB(220, 230, 240)
		elseif mission.biome == "autumn" then Color3.fromRGB(168, 102, 44)
		elseif mission.biome == "desert" then Color3.fromRGB(128, 142, 74)
		else Color3.fromRGB(54, 92, 46)

	for idx, tPos in ipairs(treePositions) do
		local treeModel = Instance.new("Model")
		treeModel.Name = "BattleTree_" .. tostring(idx)
		treeModel.Parent = mapFolder
		makePart(treeModel, "Trunk", Vector3.new(1.8, 7, 1.8), CFrame.new(tPos + Vector3.new(0, 3.5, 0)), Color3.fromRGB(92, 68, 46), Enum.Material.Wood, true)
		makePart(treeModel, "Canopy", Vector3.new(7.5, 7.5, 7.5), CFrame.new(tPos + Vector3.new(0, 8.8, 0)), foliageColor, Enum.Material.Grass, false)
	end

	-- Instanciar las 3 Banderas Estratégicas de Captura
	for _, fDef in ipairs(mission.flags) do
		local fModel = Instance.new("Model")
		fModel.Name = fDef.id
		fModel.Parent = flagsFolder

		local ring = makePart(
			fModel,
			"CaptureZoneRing",
			Vector3.new(0.4, 24, 24),
			CFrame.new(fDef.pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(230, 200, 90),
			Enum.Material.Neon,
			false
		)
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.65

		local pole = makePart(
			fModel,
			"FlagPole",
			Vector3.new(0.6, 15, 0.6),
			CFrame.new(fDef.pos + Vector3.new(0, 7.5, 0)),
			Color3.fromRGB(210, 214, 220),
			Enum.Material.Metal,
			false
		)
		fModel.PrimaryPart = pole

		local bannerColor = if fDef.initialOwner == 0
			then Color3.fromRGB(52, 168, 83)
			elseif fDef.initialOwner == 1 then Color3.fromRGB(220, 62, 54)
			else Color3.fromRGB(240, 210, 90)

		makePart(
			fModel,
			"FlagCloth",
			Vector3.new(0.3, 3.2, 5.2),
			CFrame.new(fDef.pos + Vector3.new(0, 13.2, 2.7)),
			bannerColor,
			Enum.Material.Fabric,
			false
		)

		local bb = Instance.new("BillboardGui")
		bb.Name = "FlagHud"
		bb.Size = UDim2.new(0, 170, 0, 42)
		bb.StudsOffset = Vector3.new(0, 16.5, 0)
		bb.AlwaysOnTop = true
		bb.Parent = pole

		local lbl = Instance.new("TextLabel")
		lbl.Name = "Title"
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundColor3 = Color3.fromRGB(15, 22, 30)
		lbl.BackgroundTransparency = 0.25
		lbl.TextColor3 = Color3.fromRGB(248, 250, 252)
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 13
		lbl.Text = "⚑ " .. fDef.name
		lbl.Parent = bb

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = lbl

		local initProg = if fDef.initialOwner == 0 then 100 elseif fDef.initialOwner == 1 then -100 else 0
		table.insert(WorldSimService.flags, {
			id = fDef.id,
			name = fDef.name,
			pos = fDef.pos,
			owner = fDef.initialOwner,
			captureProgress = initProg,
			model = fModel,
		})
	end
end

-- ============================================================================
-- GENERADOR DE MODELOS 3D ARTICULADOS (INFANTERÍA Y TANQUES)
-- ============================================================================
local function buildUnitModel(unit: UnitEntity): Model
	WorldSimService.ensureContainers()
	local facDef = WarOfMenCatalog.FACTIONS[unit.faction] or WarOfMenCatalog.FACTIONS.USA
	local m = Instance.new("Model")
	m.Name = string.format("Unit_%d_%s", unit.id, unit.templateId)
	m:SetAttribute("UnitId", unit.id)
	m:SetAttribute("Team", unit.team)
	m:SetAttribute("Faction", unit.faction)
	m:SetAttribute("Kind", unit.kind)
	m:SetAttribute("Role", unit.role)
	m:SetAttribute("UnitName", unit.name)
	m:SetAttribute("Hp", unit.hp)
	m:SetAttribute("MaxHp", unit.maxHp)
	m:SetAttribute("Posture", unit.posture)
	m:SetAttribute("FireMode", unit.fireMode)

	local teamColor = if unit.team == 0 then Color3.fromRGB(74, 222, 128) else Color3.fromRGB(248, 113, 113)
	local baseCf = CFrame.new(unit.pos) * CFrame.Angles(0, unit.yaw, 0)

	if unit.kind == "infantry" then
		local root = makePart(m, "HumanoidRootPart", Vector3.new(2.0, 2.2, 1.2), baseCf * CFrame.new(0, 2.6, 0), facDef.uniformColor, Enum.Material.Fabric, false)
		m.PrimaryPart = root

		makePart(m, "Head", Vector3.new(1.15, 1.15, 1.15), baseCf * CFrame.new(0, 4.3, 0), Color3.fromRGB(232, 196, 162), Enum.Material.SmoothPlastic, false)
		makePart(m, "Helmet", Vector3.new(1.32, 0.65, 1.35), baseCf * CFrame.new(0, 4.68, 0), facDef.helmetColor, Enum.Material.Metal, false)
		makePart(m, "LeftLeg", Vector3.new(0.85, 2.0, 0.85), baseCf * CFrame.new(-0.5, 1.0, 0), facDef.uniformColor, Enum.Material.Fabric, false)
		makePart(m, "RightLeg", Vector3.new(0.85, 2.0, 0.85), baseCf * CFrame.new(0.5, 1.0, 0), facDef.uniformColor, Enum.Material.Fabric, false)
		makePart(m, "LeftArm", Vector3.new(0.75, 1.9, 0.75), baseCf * CFrame.new(-1.3, 2.7, 0.35), facDef.uniformColor, Enum.Material.Fabric, false)
		makePart(m, "RightArm", Vector3.new(0.75, 1.9, 0.75), baseCf * CFrame.new(1.3, 2.7, 0.35), facDef.uniformColor, Enum.Material.Fabric, false)

		local gunLen = if unit.role == "at" then 4.2 elseif unit.role == "mg" then 3.5 else 2.9
		local weaponPart = makePart(m, "WeaponPart", Vector3.new(0.35, 0.42, gunLen), baseCf * CFrame.new(0.85, 2.75, 1.4), Color3.fromRGB(48, 52, 56), Enum.Material.Metal, false)
		local muzzle = Instance.new("Attachment")
		muzzle.Name = "Muzzle"
		muzzle.Position = Vector3.new(0, 0, gunLen * 0.5)
		muzzle.Parent = weaponPart

		-- Base táctica de facción bajo los pies
		local ring = makePart(
			m,
			"TeamBaseRing",
			Vector3.new(0.18, 3.6, 3.6),
			CFrame.new(unit.pos + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			teamColor,
			Enum.Material.Neon,
			false
		)
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.45
	else
		-- Vehículo Blindado / Tanque con Torreta y Cañón Articulados
		local hullSize = Vector3.new(8.6, 3.2, 14.5)
		local hull = makePart(m, "Hull", hullSize, baseCf * CFrame.new(0, 2.2, 0), facDef.tankColor, Enum.Material.Metal, true)
		m.PrimaryPart = hull

		makePart(m, "LeftTrack", Vector3.new(1.6, 2.4, hullSize.Z + 0.6), baseCf * CFrame.new(-hullSize.X * 0.52, 1.2, 0), Color3.fromRGB(36, 38, 40), Enum.Material.Slate, false)
		makePart(m, "RightTrack", Vector3.new(1.6, 2.4, hullSize.Z + 0.6), baseCf * CFrame.new(hullSize.X * 0.52, 1.2, 0), Color3.fromRGB(36, 38, 40), Enum.Material.Slate, false)

		local turretCf = CFrame.new(unit.pos + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, unit.turretYaw, 0)
		makePart(m, "Turret", Vector3.new(5.4, 2.2, 6.4), turretCf, facDef.tankColor, Enum.Material.Metal, false)
		local barrel = makePart(m, "GunBarrel", Vector3.new(0.75, 0.75, 9.2), turretCf * CFrame.new(0, 0.15, 6.2), Color3.fromRGB(58, 64, 68), Enum.Material.Metal, false)
		local muzzle = Instance.new("Attachment")
		muzzle.Name = "Muzzle"
		muzzle.Position = Vector3.new(0, 0, 4.6)
		muzzle.Parent = barrel

		local ring = makePart(
			m,
			"TeamBaseRing",
			Vector3.new(0.22, 14.5, 14.5),
			CFrame.new(unit.pos + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			teamColor,
			Enum.Material.Neon,
			false
		)
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.52
	end

	-- Etiqueta flotante de Salud y Clase (BillboardGui)
	if m.PrimaryPart then
		local bb = Instance.new("BillboardGui")
		bb.Name = "UnitStatusGui"
		bb.Size = UDim2.new(0, 110, 0, 28)
		bb.StudsOffset = Vector3.new(0, if unit.kind == "vehicle" then 6.2 else 4.2, 0)
		bb.MaxDistance = 240
		bb.AlwaysOnTop = true
		bb.Parent = m.PrimaryPart

		local bg = Instance.new("Frame")
		bg.Name = "BarBg"
		bg.Size = UDim2.new(1, 0, 0, 7)
		bg.Position = UDim2.new(0, 0, 1, -8)
		bg.BackgroundColor3 = Color3.fromRGB(20, 24, 30)
		bg.BorderSizePixel = 0
		bg.Parent = bb

		local fill = Instance.new("Frame")
		fill.Name = "BarFill"
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.BackgroundColor3 = teamColor
		fill.BorderSizePixel = 0
		fill.Parent = bg

		local title = Instance.new("TextLabel")
		title.Name = "UnitTitle"
		title.Size = UDim2.new(1, 0, 0, 16)
		title.Position = UDim2.new(0, 0, 0, 0)
		title.BackgroundTransparency = 1
		title.TextColor3 = Color3.fromRGB(245, 248, 252)
		title.TextStrokeTransparency = 0.25
		title.Font = Enum.Font.GothamBold
		title.TextSize = 11
		title.Text = unit.name
		title.Parent = bb
	end

	if unitsFolder then
		m.Parent = unitsFolder
	end
	return m
end

local function updateUnitModelTransform(unit: UnitEntity, dt: number, isMoving: boolean)
	local m = unit.model
	if not m or not m.PrimaryPart then
		return
	end

	m:SetAttribute("Hp", unit.hp)
	m:SetAttribute("Posture", unit.posture)
	m:SetAttribute("FireMode", unit.fireMode)
	m:SetAttribute("InCover", unit.inCover)

	local baseCf = CFrame.new(unit.pos) * CFrame.Angles(0, unit.yaw, 0)

	if unit.kind == "infantry" then
		if isMoving then
			unit.walkCycle = (unit.walkCycle + dt * 9.5) % (math.pi * 2)
		else
			unit.walkCycle = 0
		end
		local swing = math.sin(unit.walkCycle) * 0.45

		local yOffset = 2.6
		local pitch = 0
		if unit.posture == "crouch" then
			yOffset = 1.85
			pitch = math.rad(-15)
		elseif unit.posture == "prone" then
			yOffset = 0.85
			pitch = math.rad(-78)
		end

		local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.CFrame = baseCf * CFrame.new(0, yOffset, 0) * CFrame.Angles(pitch, 0, 0)
		end
		local head = m:FindFirstChild("Head") :: BasePart?
		if head then
			head.CFrame = baseCf * CFrame.new(0, yOffset + 1.65, 0)
		end
		local helmet = m:FindFirstChild("Helmet") :: BasePart?
		if helmet then
			helmet.CFrame = baseCf * CFrame.new(0, yOffset + 2.02, 0)
		end
		local lLeg = m:FindFirstChild("LeftLeg") :: BasePart?
		if lLeg then
			lLeg.CFrame = baseCf * CFrame.new(-0.5, math.max(0.5, yOffset - 1.5), swing * 0.45) * CFrame.Angles(swing, 0, 0)
		end
		local rLeg = m:FindFirstChild("RightLeg") :: BasePart?
		if rLeg then
			rLeg.CFrame = baseCf * CFrame.new(0.5, math.max(0.5, yOffset - 1.5), -swing * 0.45) * CFrame.Angles(-swing, 0, 0)
		end
		local lArm = m:FindFirstChild("LeftArm") :: BasePart?
		if lArm then
			lArm.CFrame = baseCf * CFrame.new(-1.25, yOffset + 0.1, 0.45) * CFrame.Angles(math.rad(65), 0, 0)
		end
		local rArm = m:FindFirstChild("RightArm") :: BasePart?
		if rArm then
			rArm.CFrame = baseCf * CFrame.new(1.25, yOffset + 0.1, 0.45) * CFrame.Angles(math.rad(65), 0, 0)
		end
		local wPart = m:FindFirstChild("WeaponPart") :: BasePart?
		if wPart then
			wPart.CFrame = baseCf * CFrame.new(0.85, yOffset + 0.15, 1.45)
		end
	else
		-- Vehículo Blindado
		local hull = m:FindFirstChild("Hull") :: BasePart?
		if hull then
			hull.CFrame = baseCf * CFrame.new(0, 2.2, 0)
		end
		local lTrack = m:FindFirstChild("LeftTrack") :: BasePart?
		if lTrack then
			lTrack.CFrame = baseCf * CFrame.new(-4.5, 1.2, 0)
		end
		local rTrack = m:FindFirstChild("RightTrack") :: BasePart?
		if rTrack then
			rTrack.CFrame = baseCf * CFrame.new(4.5, 1.2, 0)
		end
		local turretCf = CFrame.new(unit.pos + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, unit.turretYaw, 0)
		local turret = m:FindFirstChild("Turret") :: BasePart?
		if turret then
			turret.CFrame = turretCf
		end
		local barrel = m:FindFirstChild("GunBarrel") :: BasePart?
		if barrel then
			barrel.CFrame = turretCf * CFrame.new(0, 0.15, 6.2)
		end
	end

	local ring = m:FindFirstChild("TeamBaseRing") :: BasePart?
	if ring then
		ring.CFrame = CFrame.new(unit.pos + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end

	local bb = m.PrimaryPart:FindFirstChild("UnitStatusGui") :: BillboardGui?
	if bb then
		local barBg = bb:FindFirstChild("BarBg")
		local barFill = if barBg then barBg:FindFirstChild("BarFill") :: Frame? else nil
		if barFill then
			local ratio = math.clamp(unit.hp / math.max(1, unit.maxHp), 0, 1)
			barFill.Size = UDim2.new(ratio, 0, 1, 0)
		end
	end
end

function WorldSimService.syncUnitModelImmediate(unit: UnitEntity, isMoving: boolean?)
	updateUnitModelTransform(unit, 0.05, isMoving == true)
end

function WorldSimService.spawnUnit(templateId: string, team: number, faction: WarOfMenCatalog.FactionId, pos: Vector3, yaw: number): UnitEntity?
	local tpl = WarOfMenCatalog.UNIT_TEMPLATES[templateId]
	if not tpl then
		return nil
	end

	local id = WorldSimService.nextUnitId
	WorldSimService.nextUnitId += 1

	local u: UnitEntity = {
		id = id,
		templateId = templateId,
		name = tpl.name,
		team = team,
		faction = faction,
		kind = tpl.kind,
		role = tpl.role,
		hp = tpl.maxHp,
		maxHp = tpl.maxHp,
		speed = tpl.speed,
		pos = Vector3.new(pos.X, 0, pos.Z),
		targetPos = nil,
		yaw = yaw,
		turretYaw = yaw,
		posture = "stand",
		fireMode = "free",
		inCover = false,
		weaponId = tpl.weaponId,
		secondaryWeaponId = tpl.secondaryWeaponId,
		cooldownTimer = math.random() * 0.5,
		secondaryCooldown = 0.5,
		targetUnitId = nil,
		armor = tpl.armor,
		veterancy = 0,
		kills = 0,
		model = nil,
		walkCycle = 0,
		directControlUntil = 0,
		hasExplicitOrder = false,
		hasExplicitTarget = false,
	}

	u.model = buildUnitModel(u)
	WorldSimService.units[id] = u
	return u
end

function WorldSimService.spawnReinforcement(team: number, reinfId: string): boolean
	local mission = WorldSimService.missionDef
	local faction = if team == 0 then mission.playerFaction else mission.enemyFaction

	local foundDef: WarOfMenCatalog.ReinforcementDef? = nil
	for _, r in ipairs(WarOfMenCatalog.REINFORCEMENTS) do
		if r.id == reinfId then
			foundDef = r
			break
		end
	end
	if not foundDef then
		return false
	end

	local cdMap = WorldSimService.reinfCooldowns[team]
	if (cdMap[reinfId] or 0) > 0 then
		return false
	end
	if (WorldSimService.teamMp[team] or 0) < foundDef.costMp then
		return false
	end

	WorldSimService.teamMp[team] -= foundDef.costMp
	cdMap[reinfId] = foundDef.cooldown

	local baseX = if team == 0 then -132 else 132
	local yaw = if team == 0 then math.rad(90) else math.rad(-90)
	local zCenter = (math.random() - 0.5) * 44

	local spawnedIds = {}
	for idx, tplId in ipairs(foundDef.units) do
		local row = math.floor((idx - 1) / 3)
		local col = (idx - 1) % 3
		local spawnPos = Vector3.new(baseX + (if team == 0 then -row * 7 else row * 7), 0, zCenter + (col - 1) * 6.5)
		local u = WorldSimService.spawnUnit(tplId, team, faction, spawnPos, yaw)
		if u then
			-- Avanzar hacia la línea del frente al desplegarse
			local advanceX = if team == 0 then -82 else 82
			u.targetPos = Vector3.new(advanceX + (math.random() - 0.5) * 14, 0, spawnPos.Z)
			table.insert(spawnedIds, u.id)
		end
	end

	NetProtocol.fireAllClients(NetProtocol.EVENTS.BattleBannerBroadcast, {
		team = team,
		title = string.format("%s REINFORCEMENTS DEPLOYED", faction),
		subtitle = foundDef.name,
		spawnedUnitIds = spawnedIds,
	})
	return true
end

function WorldSimService.loadMission(missionId: string)
	WorldSimService.ensureContainers()
	local mission = WarOfMenCatalog.getMissionById(missionId)
	WorldSimService.currentMissionId = mission.id
	WorldSimService.missionDef = mission
	WorldSimService.tickCount = 0
	WorldSimService.elapsedTime = 0
	WorldSimService.matchOver = false
	WorldSimService.winnerTeam = -1
	WorldSimService.teamMp[0] = mission.startMp
	WorldSimService.teamMp[1] = mission.startMp
	WorldSimService.teamVp[0] = 500
	WorldSimService.teamVp[1] = 500
	WorldSimService.reinfCooldowns[0] = {}
	WorldSimService.reinfCooldowns[1] = {}

	for _, u in pairs(WorldSimService.units) do
		if u.model then
			u.model:Destroy()
		end
	end
	table.clear(WorldSimService.units)
	if unitsFolder then
		unitsFolder:ClearAllChildren()
	end
	if wrecksFolder then
		wrecksFolder:ClearAllChildren()
	end

	WorldSimService.buildBattlefieldGeometry(mission)

	-- Despliegue Inicial Balanceado de Fuerzas Aliadas (Team 0) y del Eje/Oponente (Team 1)
	local pReinf = WarOfMenCatalog.getReinforcementsForFaction(mission.playerFaction)
	local eReinf = WarOfMenCatalog.getReinforcementsForFaction(mission.enemyFaction)

	if #pReinf >= 1 then
		for i, tplId in ipairs(pReinf[1].units) do
			local u = WorldSimService.spawnUnit(tplId, 0, mission.playerFaction, Vector3.new(-98 - (i % 2) * 6, 0, -34 + i * 6.5), math.rad(90))
			if u then
				u.targetPos = Vector3.new(-48 - (i % 2) * 4, 0, -30 + i * 5)
			end
		end
	end
	if #pReinf >= 2 then
		for i, tplId in ipairs(pReinf[2].units) do
			local u = WorldSimService.spawnUnit(tplId, 0, mission.playerFaction, Vector3.new(-98 - (i % 2) * 6, 0, 10 + i * 6.5), math.rad(90))
			if u then
				u.targetPos = Vector3.new(-48 - (i % 2) * 4, 0, 14 + i * 5)
			end
		end
	end
	if #pReinf >= 4 then
		local u = WorldSimService.spawnUnit(pReinf[4].units[1], 0, mission.playerFaction, Vector3.new(-114, 0, 0), math.rad(90))
		if u then
			u.targetPos = Vector3.new(-62, 0, 0)
		end
	end

	if #eReinf >= 1 then
		for i, tplId in ipairs(eReinf[1].units) do
			local u = WorldSimService.spawnUnit(tplId, 1, mission.enemyFaction, Vector3.new(98 + (i % 2) * 6, 0, -34 + i * 6.5), math.rad(-90))
			if u then
				u.targetPos = Vector3.new(48 + (i % 2) * 4, 0, -30 + i * 5)
			end
		end
	end
	if #eReinf >= 2 then
		for i, tplId in ipairs(eReinf[2].units) do
			local u = WorldSimService.spawnUnit(tplId, 1, mission.enemyFaction, Vector3.new(98 + (i % 2) * 6, 0, 10 + i * 6.5), math.rad(-90))
			if u then
				u.targetPos = Vector3.new(48 + (i % 2) * 4, 0, 14 + i * 5)
			end
		end
	end
	if #eReinf >= 3 then
		local u = WorldSimService.spawnUnit(eReinf[3].units[1], 1, mission.enemyFaction, Vector3.new(114, 0, 0), math.rad(-90))
		if u then
			u.targetPos = Vector3.new(62, 0, 0)
		end
	end

	NetProtocol.fireAllClients(NetProtocol.EVENTS.BattleBannerBroadcast, {
		team = 0,
		title = mission.title,
		subtitle = mission.theater .. " — Capture the tactical sectors!",
	})
end

local function spawnVehicleWreck(unit: UnitEntity)
	if not wrecksFolder then
		return
	end
	local w = makePart(
		wrecksFolder,
		"Wreck_" .. unit.name,
		Vector3.new(8.2, 3.0, 13.8),
		CFrame.new(unit.pos + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, unit.yaw, math.rad(4)),
		Color3.fromRGB(32, 30, 28),
		Enum.Material.CorrodedMetal,
		false
	)
	local fire = Instance.new("Fire")
	fire.Size = 9
	fire.Heat = 12
	fire.Parent = w

	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(45, 45, 45)
	smoke.Opacity = 0.65
	smoke.Size = 8
	smoke.Parent = w

	Debris:AddItem(w, 18)
end

function WorldSimService.handleUnitElimination(victim: UnitEntity, killer: UnitEntity?)
	if victim.kind == "vehicle" then
		spawnVehicleWreck(victim)
	end
	if victim.model then
		victim.model:Destroy()
		victim.model = nil
	end
	WorldSimService.units[victim.id] = nil

	if killer then
		killer.kills += 1
		killer.veterancy = math.min(3, math.floor(killer.kills / 2))
		if killer.team == 0 then
			ProfileStoreService.addStats(
				nil,
				if victim.kind == "vehicle" then 65 else 20,
				if victim.kind == "infantry" then 1 else 0,
				if victim.kind == "vehicle" then 1 else 0,
				0,
				0
			)
		end
	end
end

function WorldSimService.fireWeaponAt(shooter: UnitEntity, target: UnitEntity, weaponId: string)
	local weapon = WarOfMenCatalog.WEAPONS[weaponId]
	if not weapon then
		return
	end

	-- Orientar torreta o soldado hacia el objetivo
	local dir = target.pos - shooter.pos
	if dir.Magnitude > 0.1 then
		local desiredYaw = math.atan2(dir.X, dir.Z)
		shooter.turretYaw = desiredYaw
		if shooter.kind == "infantry" then
			shooter.yaw = desiredYaw
		end
	end

	local shotResult, splashHits = BallisticsCombatService.resolveShot(shooter, target, weapon, WorldSimService.units)
	if shotResult.damageDealt > 0 then
		target.hp = math.max(0, target.hp - shotResult.damageDealt)
		if target.hp <= 0 then
			shotResult.targetDestroyed = true
			WorldSimService.handleUnitElimination(target, shooter)
		end
	end

	for _, sh in ipairs(splashHits) do
		local u = sh.unit
		if u and u.hp > 0 then
			u.hp = math.max(0, u.hp - sh.splashDamage)
			if u.hp <= 0 then
				WorldSimService.handleUnitElimination(u, shooter)
			end
		end
	end

	NetProtocol.fireAllClients(NetProtocol.EVENTS.CombatShotBroadcast, shotResult)
end

function WorldSimService.stepSimulation(dt: number)
	if WorldSimService.matchOver then
		return
	end

	WorldSimService.tickCount += 1
	WorldSimService.elapsedTime += dt

	-- 1. Reducir enfriamientos de refuerzos y sumar Manpower (MP)
	for team = 0, 1 do
		local cdMap = WorldSimService.reinfCooldowns[team]
		for rId, rem in pairs(cdMap) do
			if rem > 0 then
				cdMap[rId] = math.max(0, rem - dt)
			end
		end
	end

	local ownedFlags = { [0] = 0, [1] = 0 }
	for _, fl in ipairs(WorldSimService.flags) do
		if fl.owner == 0 or fl.owner == 1 then
			ownedFlags[fl.owner] += 1
		end
	end

	for team = 0, 1 do
		local incomePerSec = 10 + ownedFlags[team] * 5.5
		WorldSimService.teamMp[team] = math.min(999, WorldSimService.teamMp[team] + incomePerSec * dt)
	end

	-- Drenaje de Puntos de Victoria (VP) si un bando domina más banderas
	if ownedFlags[0] > ownedFlags[1] then
		WorldSimService.teamVp[1] = math.max(0, WorldSimService.teamVp[1] - (ownedFlags[0] - ownedFlags[1]) * 3.2 * dt)
	elseif ownedFlags[1] > ownedFlags[0] then
		WorldSimService.teamVp[0] = math.max(0, WorldSimService.teamVp[0] - (ownedFlags[1] - ownedFlags[0]) * 3.2 * dt)
	end

	if WorldSimService.teamVp[1] <= 0 or WorldSimService.teamVp[0] <= 0 then
		WorldSimService.matchOver = true
		WorldSimService.winnerTeam = if WorldSimService.teamVp[0] > WorldSimService.teamVp[1] then 0 else 1
		NetProtocol.fireAllClients(NetProtocol.EVENTS.BattleBannerBroadcast, {
			team = WorldSimService.winnerTeam,
			title = if WorldSimService.winnerTeam == 0 then "ALLIED TACTICAL VICTORY!" else "AXIS TACTICAL VICTORY!",
			subtitle = "Sector supremacy achieved — Starting new operation in 8s...",
		})
		task.delay(8, function()
			if WorldSimService.matchOver then
				WorldSimService.loadMission(WorldSimService.currentMissionId)
			end
		end)
		return
	end

	-- 2. Actualizar Unidades (Movimiento, Cobertura, Postura y Disparo)
	for _, u in pairs(WorldSimService.units) do
		if u.hp > 0 then
			-- Evaluar cobertura cercana para infantería
			if u.kind == "infantry" then
				local nearCover = false
				for _, cPos in ipairs(WorldSimService.coverPositions) do
					if (u.pos - cPos).Magnitude <= 10.5 then
						nearCover = true
						break
					end
				end
				u.inCover = nearCover
			end

			local isMoving = false
			if u.targetPos and os.clock() > u.directControlUntil then
				local delta = Vector3.new(u.targetPos.X - u.pos.X, 0, u.targetPos.Z - u.pos.Z)
				local dist = delta.Magnitude
				if dist > 1.4 then
					isMoving = true
					local dir = delta.Unit
					local postureSpeedMult = if u.posture == "prone"
						then 0.45
						elseif u.posture == "crouch" then 0.75
						else 1.0
					local step = math.min(dist, u.speed * postureSpeedMult * dt)
					local nextPos = u.pos + dir * step
					-- Evitar caer al agua fuera del puente central o los vados norte/sur
					if math.abs(nextPos.X) < 13 and math.abs(nextPos.Z) > 13 and math.abs(math.abs(nextPos.Z) - 68) > 11 then
						-- Redirigir hacia el puente o vado más cercano
						local targetFordZ = if math.abs(nextPos.Z) < 38 then 0 elseif nextPos.Z > 0 then 68 else -68
						local redirectDir = Vector3.new(0, 0, targetFordZ - u.pos.Z)
						if redirectDir.Magnitude > 0.1 then
							nextPos = u.pos + redirectDir.Unit * step
						end
					end
					u.pos = Vector3.new(math.clamp(nextPos.X, -155, 155), 0, math.clamp(nextPos.Z, -108, 108))
					u.yaw = math.atan2(dir.X, dir.Z)
					if not u.targetUnitId then
						u.turretYaw = u.yaw
					end
				else
					u.targetPos = nil
					-- Si llega a cobertura, agacharse automáticamente
					if u.kind == "infantry" and u.inCover and u.posture == "stand" then
						u.posture = "crouch"
					end
				end
			end

			-- Combate y Enfriamiento de Armas
			u.cooldownTimer = math.max(0, u.cooldownTimer - dt)
			u.secondaryCooldown = math.max(0, u.secondaryCooldown - dt)

			if u.fireMode ~= "hold" and os.clock() > u.directControlUntil then
				local weapon = WarOfMenCatalog.WEAPONS[u.weaponId]
				if weapon then
					local target = if u.targetUnitId then WorldSimService.units[u.targetUnitId] else nil
					if not target or target.hp <= 0 then
						u.targetUnitId = nil
						u.hasExplicitTarget = false
						target = nil
					elseif not u.hasExplicitTarget and (target.pos - u.pos).Magnitude > weapon.range * 1.05 then
						u.targetUnitId = nil
						target = nil
					end

					if target then
						local d = (target.pos - u.pos).Magnitude
						if d <= weapon.range then
							if u.hasExplicitTarget then
								u.targetPos = nil
							end
							local aimDir = target.pos - u.pos
							if aimDir.Magnitude > 0.1 then
								u.turretYaw = math.atan2(aimDir.X, aimDir.Z)
								if u.kind == "infantry" and not isMoving then
									u.yaw = u.turretYaw
								end
							end
							if u.cooldownTimer <= 0 then
								u.cooldownTimer = weapon.cooldown
								WorldSimService.fireWeaponAt(u, target, u.weaponId)
							end
						elseif u.hasExplicitTarget then
							-- Avanzar hacia el objetivo ordenado explícitamente por el jugador hasta entrar en rango
							u.targetPos = target.pos
						end
					end

					-- Ametralladora coaxial secundaria de tanques
					if u.secondaryWeaponId and u.secondaryCooldown <= 0 and target and target.hp > 0 then
						local secWep = WarOfMenCatalog.WEAPONS[u.secondaryWeaponId]
						if secWep and (target.pos - u.pos).Magnitude <= secWep.range then
							u.secondaryCooldown = secWep.cooldown
							WorldSimService.fireWeaponAt(u, target, u.secondaryWeaponId)
						end
					end
				end
			end

			updateUnitModelTransform(u, dt, isMoving)
		end
	end

	-- 3. Captura de Banderas Estratégicas
	for _, fl in ipairs(WorldSimService.flags) do
		local count0 = 0
		local count1 = 0
		for _, u in pairs(WorldSimService.units) do
			if u.hp > 0 and (u.pos - fl.pos).Magnitude <= 18 then
				if u.team == 0 then
					count0 += if u.kind == "vehicle" then 2 else 1
				else
					count1 += if u.kind == "vehicle" then 2 else 1
				end
			end
		end

		local prevOwner = fl.owner
		if count0 > count1 then
			fl.captureProgress = math.min(100, fl.captureProgress + (count0 - count1) * 14 * dt)
		elseif count1 > count0 then
			fl.captureProgress = math.max(-100, fl.captureProgress - (count1 - count0) * 14 * dt)
		end

		if fl.captureProgress >= 65 then
			fl.owner = 0
		elseif fl.captureProgress <= -65 then
			fl.owner = 1
		elseif math.abs(fl.captureProgress) < 20 then
			fl.owner = -1
		end

		if fl.owner ~= prevOwner and (fl.owner == 0 or fl.owner == 1) then
			if fl.owner == 0 then
				ProfileStoreService.addStats(nil, 45, 0, 0, 1, 0)
			end
			NetProtocol.fireAllClients(NetProtocol.EVENTS.BattleBannerBroadcast, {
				team = fl.owner,
				title = string.format("SECTOR CAPTURED: %s", string.upper(fl.name)),
				subtitle = if fl.owner == 0 then "Allied forces hold the sector!" else "Enemy forces seized the sector!",
			})
		end

		if fl.model then
			local bColor = if fl.owner == 0
				then Color3.fromRGB(52, 198, 98)
				elseif fl.owner == 1 then Color3.fromRGB(235, 68, 60)
				else Color3.fromRGB(240, 210, 90)
			local cloth = fl.model:FindFirstChild("FlagCloth") :: BasePart?
			if cloth then
				cloth.Color = bColor
			end
			local ring = fl.model:FindFirstChild("CaptureZoneRing") :: BasePart?
			if ring then
				ring.Color = bColor
			end
			local pole = fl.model:FindFirstChild("FlagPole")
			local gui = if pole then pole:FindFirstChild("FlagHud") else nil
			local lbl = if gui then gui:FindFirstChild("Title") :: TextLabel? else nil
			if lbl then
				lbl.Text = string.format("⚑ %s (%d%%)", fl.name, math.abs(math.floor(fl.captureProgress)))
			end
		end
	end
end

function WorldSimService.buildStateSnapshot()
	local unitList = {}
	for _, u in pairs(WorldSimService.units) do
		table.insert(unitList, {
			id = u.id,
			templateId = u.templateId,
			name = u.name,
			team = u.team,
			faction = u.faction,
			kind = u.kind,
			role = u.role,
			hp = u.hp,
			maxHp = u.maxHp,
			pos = u.pos,
			targetPos = u.targetPos,
			yaw = u.yaw,
			turretYaw = u.turretYaw,
			posture = u.posture,
			fireMode = u.fireMode,
			inCover = u.inCover,
			weaponId = u.weaponId,
			kills = u.kills,
			veterancy = u.veterancy,
		})
	end

	local flagList = {}
	for _, f in ipairs(WorldSimService.flags) do
		table.insert(flagList, {
			id = f.id,
			name = f.name,
			pos = f.pos,
			owner = f.owner,
			captureProgress = math.floor(f.captureProgress),
		})
	end

	return {
		missionId = WorldSimService.currentMissionId,
		missionTitle = WorldSimService.missionDef.title,
		playerFaction = WorldSimService.missionDef.playerFaction,
		enemyFaction = WorldSimService.missionDef.enemyFaction,
		elapsedTime = math.floor(WorldSimService.elapsedTime),
		teamMp = { [0] = math.floor(WorldSimService.teamMp[0]), [1] = math.floor(WorldSimService.teamMp[1]) },
		teamVp = { [0] = math.floor(WorldSimService.teamVp[0]), [1] = math.floor(WorldSimService.teamVp[1]) },
		reinfCooldowns = WorldSimService.reinfCooldowns[0],
		playerBotMode = WorldSimService.playerBotMode,
		flags = flagList,
		units = unitList,
	}
end

return WorldSimService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX_SRV_AI">
			<Properties>
				<string name="Name">TacticalAIService</string>
				<ProtectedString name="Source"><![CDATA[--!strict
--[[
	TacticalAIService.luau
	Inteligencia Artificial Táctica Balanceada para "War of Men":
	  1. Adquisición de blancos por prioridad balística respetando siempre las órdenes explícitas del jugador
	  2. Comandante IA del Eje/Oponente (Team 1): avance táctico por sectores y oleadas balanceadas
	  3. Player-Bot Asistente (Team 0): modos OFF, DEFEND y ATTACK (solo para unidades sin orden manual activa)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local WarOfMenCatalog = require(Shared:WaitForChild("WarOfMenCatalog"))
local WorldSimService = require(ServerScriptService:WaitForChild("WorldSimService"))

local TacticalAIService = {}

local aiTimer = 0
local commanderTimer = 0
local reinfTimer = 0

local function acquireBestTarget(u: WorldSimService.UnitEntity)
	if u.fireMode == "hold" then
		return
	end
	local weapon = WarOfMenCatalog.WEAPONS[u.weaponId]
	if not weapon then
		return
	end

	-- Si el jugador le asignó un blanco explícito y sigue vivo, respetarlo al 100%
	if u.hasExplicitTarget and u.targetUnitId then
		local explicitTarget = WorldSimService.units[u.targetUnitId]
		if explicitTarget and explicitTarget.hp > 0 then
			return
		end
		u.hasExplicitTarget = false
	end

	-- Si ya tiene un objetivo automático válido dentro de rango, mantenerlo
	if u.targetUnitId then
		local existing = WorldSimService.units[u.targetUnitId]
		if existing and existing.hp > 0 and (existing.pos - u.pos).Magnitude <= weapon.range then
			return
		end
	end

	local bestTargetId: number? = nil
	local bestScore = -999999

	for _, other in pairs(WorldSimService.units) do
		if other.team ~= u.team and other.hp > 0 then
			local dist = (other.pos - u.pos).Magnitude
			if dist <= weapon.range then
				local score = 200 - dist
				if other.kind == "vehicle" then
					if weapon.category == "cannon" or weapon.category == "at_rocket" then
						score += 140
					else
						score -= 220
					end
				else
					if weapon.category == "mg" or weapon.category == "small_arms" then
						score += 65
					end
				end
				if score > bestScore then
					bestScore = score
					bestTargetId = other.id
				end
			end
		end
	end

	if bestTargetId and bestScore > -100 then
		u.targetUnitId = bestTargetId
	end
end

local function issueCommanderOrdersForTeam(team: number, aggressive: boolean)
	local flags = WorldSimService.flags
	if #flags == 0 then
		return
	end

	local targetFlag = flags[2] or flags[1]
	for _, fl in ipairs(flags) do
		if aggressive then
			if fl.id == "flag_center" and fl.owner ~= team then
				targetFlag = fl
				break
			elseif fl.owner ~= team then
				targetFlag = fl
				break
			end
		else
			if fl.owner == team or fl.id == "flag_center" then
				targetFlag = fl
				break
			end
		end
	end

	local movedCount = 0
	local maxAdvanceBatch = if team == 1 then 6 else 12

	for _, u in pairs(WorldSimService.units) do
		if u.team == team and u.hp > 0 and os.clock() > u.directControlUntil then
			-- Nunca sobreescribir unidades controladas u ordenadas explícitamente por el jugador
			if team == 0 and u.hasExplicitOrder then
				continue
			end
			if not u.targetPos and not u.targetUnitId then
				local distToFlag = (u.pos - targetFlag.pos).Magnitude
				if distToFlag > 20 then
					local spread = Vector3.new((math.random() - 0.5) * 24, 0, (math.random() - 0.5) * 24)
					u.targetPos = targetFlag.pos + spread
					movedCount += 1
					if movedCount >= maxAdvanceBatch then
						break
					end
				end
			end
		end
	end
end

local function tryCallAIReinforcement(team: number, faction: WarOfMenCatalog.FactionId, minMpReserve: number)
	local mp = WorldSimService.teamMp[team] or 0
	if mp < minMpReserve then
		return
	end

	local countTeam = 0
	local countVehicles = 0
	for _, u in pairs(WorldSimService.units) do
		if u.team == team and u.hp > 0 then
			countTeam += 1
			if u.kind == "vehicle" then
				countVehicles += 1
			end
		end
	end
	if countTeam >= 13 then
		return
	end

	local reinfList = WarOfMenCatalog.getReinforcementsForFaction(faction)
	if #reinfList == 0 then
		return
	end

	-- Evitar spamear tanques si ya hay 2 vehículos en el campo
	local choice = reinfList[1]
	if countVehicles < 2 and mp >= 270 and #reinfList >= 3 and math.random() < 0.45 then
		choice = reinfList[3]
	elseif #reinfList >= 2 and math.random() < 0.5 then
		choice = reinfList[2]
	end

	WorldSimService.spawnReinforcement(team, choice.id)
end

function TacticalAIService.stepAI(dt: number)
	if WorldSimService.matchOver then
		return
	end

	aiTimer += dt
	commanderTimer += dt
	reinfTimer += dt

	if aiTimer >= 0.25 then
		aiTimer = 0
		for _, u in pairs(WorldSimService.units) do
			if u.hp > 0 then
				acquireBestTarget(u)
			end
		end
	end

	if commanderTimer >= 4.0 then
		commanderTimer = 0
		issueCommanderOrdersForTeam(1, true)
		if WorldSimService.playerBotMode ~= "OFF" then
			issueCommanderOrdersForTeam(0, WorldSimService.playerBotMode == "ATTACK")
		end
	end

	if reinfTimer >= 11.5 then
		reinfTimer = 0
		local mission = WorldSimService.missionDef
		tryCallAIReinforcement(1, mission.enemyFaction, 185)
		if WorldSimService.playerBotMode ~= "OFF" then
			tryCallAIReinforcement(0, mission.playerFaction, 185)
		end
	end
end

return TacticalAIService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX_SRV_MAIN">
			<Properties>
				<string name="Name">GameServer</string>
				<token name="RunContext">0</token>
				<ProtectedString name="Source"><![CDATA[--!nocheck
--[[
	GameServer.server.luau
	Orquestador Principal de Servidor para "War of Men" (Roblox Engine).
	Conecta todos los eventos tácticos (RTS + Direct Control), desactiva el
	personaje por defecto de Roblox para que no interfiera con la cámara/controles RTS,
	y ejecuta el bucle de simulación y sincronización a 20 Hz.
]]

if _G.WarOfMenServerStarted then
	return
end
_G.WarOfMenServerStarted = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WarOfMenCatalog = require(Shared:WaitForChild("WarOfMenCatalog"))
local NetProtocol = require(Shared:WaitForChild("NetProtocol"))

local WorldSimService = require(ServerScriptService:WaitForChild("WorldSimService"))
local TacticalAIService = require(ServerScriptService:WaitForChild("TacticalAIService"))
local ProfileStoreService = require(ServerScriptService:WaitForChild("ProfileStoreService"))

NetProtocol.ensureRemotesFolder()
NetProtocol.ensureStudioBusFolder()

-- Cargar la misión inicial (Omaha Beachhead — Sector Charlie)
WorldSimService.loadMission("usa_normandy")

local function broadcastSnapshotNow()
	NetProtocol.fireAllClients(NetProtocol.EVENTS.SyncBattleState, WorldSimService.buildStateSnapshot())
end

-- 1. Orden de Movimiento en Formación / Parada Táctica / Retirada
NetProtocol.onServerEvent(NetProtocol.EVENTS.IssueMoveOrder, function(_player, payload)
	if type(payload) ~= "table" or type(payload.unitIds) ~= "table" then
		return
	end
	local ids = payload.unitIds

	-- Parada táctica inmediata (Hold Position / Stop [S])
	if payload.holdPosition == true then
		for _, rawId in ipairs(ids) do
			local u = WorldSimService.units[tonumber(rawId) or -1]
			if u and u.hp > 0 and u.team == 0 then
				u.targetPos = nil
				u.hasExplicitOrder = true
				u.hasExplicitTarget = false
			end
		end
		broadcastSnapshotNow()
		return
	end

	if typeof(payload.targetPos) ~= "Vector3" then
		return
	end
	local dest: Vector3 = payload.targetPos
	local count = #ids
	local cols = math.max(1, math.ceil(math.sqrt(count)))
	local spacing = 5.5

	for idx, rawId in ipairs(ids) do
		local u = WorldSimService.units[tonumber(rawId) or -1]
		if u and u.hp > 0 and u.team == 0 then
			local r = math.floor((idx - 1) / cols)
			local c = (idx - 1) % cols
			local offset = Vector3.new((c - (cols - 1) * 0.5) * spacing, 0, (r - (math.ceil(count / cols) - 1) * 0.5) * spacing)
			u.targetPos = Vector3.new(
				math.clamp(dest.X + offset.X, -152, 152),
				0,
				math.clamp(dest.Z + offset.Z, -104, 104)
			)
			u.hasExplicitOrder = true
			if not payload.attackMove then
				u.hasExplicitTarget = false
				u.targetUnitId = nil
			end
		end
	end
	broadcastSnapshotNow()
end)

-- 2. Orden de Ataque Concentrado (Clic derecho sobre enemigo)
NetProtocol.onServerEvent(NetProtocol.EVENTS.IssueAttackOrder, function(_player, payload)
	if type(payload) ~= "table" or type(payload.unitIds) ~= "table" then
		return
	end
	local targetId = tonumber(payload.targetUnitId) or -1
	local target = WorldSimService.units[targetId]
	if not target or target.hp <= 0 then
		return
	end

	for _, rawId in ipairs(payload.unitIds) do
		local u = WorldSimService.units[tonumber(rawId) or -1]
		if u and u.hp > 0 and u.team == 0 then
			u.targetUnitId = targetId
			u.hasExplicitTarget = true
			u.hasExplicitOrder = true
			local wep = WarOfMenCatalog.WEAPONS[u.weaponId]
			if wep and (target.pos - u.pos).Magnitude > wep.range * 0.92 then
				u.targetPos = target.pos
			else
				u.targetPos = nil
			end
		end
	end
	broadcastSnapshotNow()
end)

-- 3. Orden de Cambio de Postura (stand / crouch / prone)
NetProtocol.onServerEvent(NetProtocol.EVENTS.SetPostureOrder, function(_player, payload)
	if type(payload) ~= "table" or type(payload.unitIds) ~= "table" then
		return
	end
	local posture = tostring(payload.posture or "stand")
	if posture ~= "stand" and posture ~= "crouch" and posture ~= "prone" then
		return
	end
	for _, rawId in ipairs(payload.unitIds) do
		local u = WorldSimService.units[tonumber(rawId) or -1]
		if u and u.hp > 0 and u.team == 0 and u.kind == "infantry" then
			u.posture = posture
			WorldSimService.syncUnitModelImmediate(u, false)
		end
	end
	broadcastSnapshotNow()
end)

-- 4. Orden de Modo de Fuego (free / hold / return)
NetProtocol.onServerEvent(NetProtocol.EVENTS.SetFireModeOrder, function(_player, payload)
	if type(payload) ~= "table" or type(payload.unitIds) ~= "table" then
		return
	end
	local mode = tostring(payload.fireMode or "free")
	if mode ~= "free" and mode ~= "hold" and mode ~= "return" then
		return
	end
	for _, rawId in ipairs(payload.unitIds) do
		local u = WorldSimService.units[tonumber(rawId) or -1]
		if u and u.hp > 0 and u.team == 0 then
			u.fireMode = mode
			if mode == "hold" then
				u.targetUnitId = nil
				u.hasExplicitTarget = false
			end
		end
	end
	broadcastSnapshotNow()
end)

-- 5. Despliegue de Refuerzos por Puntos de Mando (MP)
NetProtocol.onServerEvent(NetProtocol.EVENTS.CallReinforcementOrder, function(_player, payload)
	if type(payload) ~= "table" then
		return
	end
	local reinfId = tostring(payload.reinfId or "")
	if reinfId ~= "" then
		WorldSimService.spawnReinforcement(0, reinfId)
		broadcastSnapshotNow()
	end
end)

-- 6. Selección de Escaramuza / Mapa (15 Misiones)
NetProtocol.onServerEvent(NetProtocol.EVENTS.SelectMissionOrder, function(_player, payload)
	if type(payload) ~= "table" then
		return
	end
	local missionId = tostring(payload.missionId or "usa_normandy")
	WorldSimService.loadMission(missionId)
	broadcastSnapshotNow()
end)

-- 7. Alternar Modo Player-Bot (OFF / DEFEND / ATTACK)
NetProtocol.onServerEvent(NetProtocol.EVENTS.ToggleBotModeOrder, function(_player, payload)
	if type(payload) ~= "table" then
		return
	end
	local mode = tostring(payload.mode or "OFF")
	if mode == "OFF" or mode == "DEFEND" or mode == "ATTACK" then
		WorldSimService.playerBotMode = mode
		broadcastSnapshotNow()
	end
end)

-- 8. Reiniciar Escaramuza Actual
NetProtocol.onServerEvent(NetProtocol.EVENTS.ResetSkirmishOrder, function()
	WorldSimService.loadMission(WorldSimService.currentMissionId)
	broadcastSnapshotNow()
end)

-- 9. Control Directo en 3ra Persona: Movimiento Fluido y Apuntado de Torreta
NetProtocol.onServerEvent(NetProtocol.EVENTS.DirectControlMoveOrder, function(_player, payload)
	if type(payload) ~= "table" then
		return
	end
	local unitId = tonumber(payload.unitId) or -1
	local u = WorldSimService.units[unitId]
	if not u or u.hp <= 0 or u.team ~= 0 then
		return
	end
	u.directControlUntil = os.clock() + 0.85
	u.hasExplicitOrder = true
	u.targetPos = nil

	if typeof(payload.aimPoint) == "Vector3" then
		local aimDir = payload.aimPoint - u.pos
		if aimDir.Magnitude > 0.2 then
			u.turretYaw = math.atan2(aimDir.X, aimDir.Z)
			if u.kind == "infantry" then
				u.yaw = u.turretYaw
			end
		end
	end

	local isMoving = false
	if typeof(payload.moveVec) == "Vector3" and payload.moveVec.Magnitude > 0.05 then
		isMoving = true
		local mv = Vector3.new(payload.moveVec.X, 0, payload.moveVec.Z).Unit
		local dtStep = math.clamp(tonumber(payload.dt) or 0.05, 0.016, 0.12)
		local postureMult = if u.posture == "prone" then 0.5 elseif u.posture == "crouch" then 0.8 else 1.05
		local nextPos = u.pos + mv * (u.speed * postureMult * dtStep)
		u.pos = Vector3.new(math.clamp(nextPos.X, -154, 154), 0, math.clamp(nextPos.Z, -106, 106))
		if u.kind == "vehicle" then
			u.yaw = math.atan2(mv.X, mv.Z)
		end
	end

	WorldSimService.syncUnitModelImmediate(u, isMoving)
end)

-- 10. Control Directo en 3ra Persona: Disparo Manual con Cono Balístico
NetProtocol.onServerEvent(NetProtocol.EVENTS.DirectControlFireOrder, function(_player, payload)
	if type(payload) ~= "table" then
		return
	end
	local unitId = tonumber(payload.unitId) or -1
	local u = WorldSimService.units[unitId]
	if not u or u.hp <= 0 or u.team ~= 0 then
		return
	end

	local useSecondary = payload.secondary == true and u.secondaryWeaponId ~= nil
	local chosenWeaponId = if useSecondary then (u.secondaryWeaponId :: string) else u.weaponId
	local weapon = WarOfMenCatalog.WEAPONS[chosenWeaponId]
	if not weapon then
		return
	end

	if useSecondary then
		if u.secondaryCooldown > 0 then
			return
		end
		u.secondaryCooldown = weapon.cooldown * 0.75
	else
		if u.cooldownTimer > 0 then
			return
		end
		u.cooldownTimer = weapon.cooldown * 0.80
	end

	u.directControlUntil = os.clock() + 0.9
	u.hasExplicitOrder = true

	local aimPoint: Vector3 = if typeof(payload.aimPoint) == "Vector3"
		then payload.aimPoint
		else (u.pos + Vector3.new(math.sin(u.turretYaw) * weapon.range, 0, math.cos(u.turretYaw) * weapon.range))

	local aimVec = Vector3.new(aimPoint.X - u.pos.X, 0, aimPoint.Z - u.pos.Z)
	local aimDir = if aimVec.Magnitude > 0.1 then aimVec.Unit else Vector3.new(math.sin(u.turretYaw), 0, math.cos(u.turretYaw))
	u.turretYaw = math.atan2(aimDir.X, aimDir.Z)
	if u.kind == "infantry" then
		u.yaw = u.turretYaw
	end

	-- Buscar blanco enemigo cercano al punto de mira O dentro del cono/línea de tiro
	local bestEnemy = nil
	local bestScore = 999999
	local maxRange = weapon.range * 1.18

	for _, other in pairs(WorldSimService.units) do
		if other.team ~= u.team and other.hp > 0 then
			local toEnemy = Vector3.new(other.pos.X - u.pos.X, 0, other.pos.Z - u.pos.Z)
			local distFromShooter = toEnemy.Magnitude
			local distToCursor = (other.pos - aimPoint).Magnitude
			if distToCursor <= 16 and distFromShooter <= maxRange then
				if distToCursor < bestScore then
					bestScore = distToCursor
					bestEnemy = other
				end
			elseif distFromShooter <= maxRange and distFromShooter > 0.5 then
				local proj = toEnemy:Dot(aimDir)
				if proj > 0 then
					local perpDist = (toEnemy - aimDir * proj).Magnitude
					local hitRadius = if other.kind == "vehicle" then 8.5 else 5.0
					if perpDist <= hitRadius then
						local score = perpDist * 3 + math.abs(distFromShooter - aimVec.Magnitude) * 0.25
						if score < bestScore then
							bestScore = score
							bestEnemy = other
						end
					end
				end
			end
		end
	end

	if bestEnemy then
		WorldSimService.fireWeaponAt(u, bestEnemy, chosenWeaponId)
	else
		local clampedTarget = if aimVec.Magnitude > weapon.range
			then (u.pos + aimDir * weapon.range)
			else aimPoint
		NetProtocol.fireAllClients(NetProtocol.EVENTS.CombatShotBroadcast, {
			shooterId = u.id,
			targetId = -1,
			weaponId = chosenWeaponId,
			fromPos = u.pos + Vector3.new(0, if u.kind == "vehicle" then 3.6 else 2.6, 0),
			toPos = clampedTarget + Vector3.new(0, 1.5, 0),
			outcome = "MISS",
			armorFace = "BODY",
			impactAngleDeg = 0,
			penetrationMm = weapon.penetration.d50,
			effectiveArmorMm = 0,
			damageDealt = 0,
			targetDestroyed = false,
			heRadius = weapon.heRadius,
		})
	end
end)

-- Neutralizar el avatar por defecto de Roblox (invisible y anclado bajo tierra con WalkSpeed = 0)
-- para que StarterGui/StarterPlayerScripts carguen siempre al 100%, pero el avatar no interfiera en la batalla
local function neutralizeDefaultCharacter(char: Model)
	task.defer(function()
		for _, inst in ipairs(char:GetDescendants()) do
			if inst:IsA("BasePart") then
				inst.Transparency = 1
				inst.CanCollide = false
				inst.CanQuery = false
				inst.Anchored = true
			elseif inst:IsA("Decal") or inst:IsA("Accessory") then
				pcall(function()
					inst:Destroy()
				end)
			elseif inst:IsA("Humanoid") then
				inst.WalkSpeed = 0
				inst.JumpPower = 0
				inst.JumpHeight = 0
			end
		end
		if char.PrimaryPart then
			char:PivotTo(CFrame.new(0, -180, 0))
		end
	end)
end

-- Sincronización de perfiles al entrar jugadores
local function setupPlayer(player: Player)
	player.CharacterAdded:Connect(neutralizeDefaultCharacter)
	if player.Character then
		neutralizeDefaultCharacter(player.Character)
	end
	task.defer(function()
		local prof = ProfileStoreService.getProfile(player.UserId)
		NetProtocol.fireClient(NetProtocol.EVENTS.SyncPlayerProfile, player, prof)
		NetProtocol.fireClient(NetProtocol.EVENTS.SyncBattleState, player, WorldSimService.buildStateSnapshot())
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do
	setupPlayer(p)
end

Players.PlayerRemoving:Connect(function(player)
	ProfileStoreService.saveProfile(player.UserId)
end)

-- Bucle Principal de Simulación y Sincronización a 20 Hz
local simAccum = 0

RunService.Heartbeat:Connect(function(dt)
	local clampedDt = math.min(dt, 0.1)
	simAccum += clampedDt

	if simAccum >= 0.05 then
		local stepDt = simAccum
		simAccum = 0
		WorldSimService.stepSimulation(stepDt)
		TacticalAIService.stepAI(stepDt)
		local snap = WorldSimService.buildStateSnapshot()
		NetProtocol.fireAllClients(NetProtocol.EVENTS.SyncBattleState, snap)
	end
end)

print("[War of Men Server] Initialized 20Hz Tactical RTS + Direct Control Simulation.")
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterGui" referent="RBX_STARTER_GUI">
		<Properties>
			<string name="Name">StarterGui</string>
		</Properties>
		<Item class="LocalScript" referent="RBX_CLIENT_STARTERGUI">
			<Properties>
				<string name="Name">WarOfMenClientStarter</string>
				<ProtectedString name="Source"><![CDATA[--!nocheck
--[[
	WarOfMenClient.client.luau
	Cliente Táctico Jugable para "War of Men" (Roblox Port de OpenMoW-Web / Men of War: Assault Squad 2).
	Características:
	  - Superficie Táctica Interactiva (TacticalViewportCanvas) compatible 100% con Studio Edit Mode, Play Mode (F5) y Roblox Player.
	  - Cámara Híbrida con prioridad RenderStep:
	      1) Vista Comandante RTS (WASD, Zoom con Rueda, Rotación Q/E, bordes de pantalla).
	      2) Modo Direct Control 3ra Persona [TAB] SIN bucle de retroalimentación de cámara, con predicción local a 60 FPS,
	         láser/retícula 3D en tiempo real, disparo primario (Clic Izq / Espacio) y coaxial/secundario (Clic Der / F).
	  - Selección Múltiple y Táctica:
	      - Clic Izquierdo sobre modelo 3D o etiqueta, Caja de Arrastre (Marquee 2D -> 3D), y botones de escuadra ([1] Inf, [2] Armor, [G] All).
	      - Modos de Orden con Clic Derecho o Botones de Acción (Move [M], Attack-Move [A], Stop/Hold [K], Retreat [R]).
	      - Anillos luminosos 3D de selección y líneas de orden en el suelo.
]]

if _G.WarOfMenClientStarted then
	return
end
_G.WarOfMenClientStarted = true

local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local isStudioEdit = false
pcall(function()
	isStudioEdit = RunService:IsStudio() and not RunService:IsRunning()
end)

local parentGui = if localPlayer and not isStudioEdit
	then localPlayer:WaitForChild("PlayerGui")
	else game:GetService("CoreGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WarOfMenCatalog = require(Shared:WaitForChild("WarOfMenCatalog"))
local NetProtocol = require(Shared:WaitForChild("NetProtocol"))

-- Desactivar controles por defecto del PlayerModule si existen para que no bloqueen WASD / Clic Derecho
pcall(function()
	ContextActionService:UnbindAction("moveForwardAction")
	ContextActionService:UnbindAction("moveBackwardAction")
	ContextActionService:UnbindAction("moveLeftAction")
	ContextActionService:UnbindAction("moveRightAction")
	ContextActionService:UnbindAction("jumpAction")
end)

-- ============================================================================
-- 1. EFECTOS DE SONIDO DE COMBATE Y RADIO (ROBLOX SOUND ENGINE)
-- ============================================================================
local function playSound(kind: string, volume: number?, pitch: number?)
	pcall(function()
		local snd = Instance.new("Sound")
		snd.Volume = volume or 0.35
		snd.PlaybackSpeed = pitch or (0.95 + math.random() * 0.12)
		if kind == "rifle" then
			snd.SoundId = "rbxassetid://138081500"
		elseif kind == "mg" then
			snd.SoundId = "rbxassetid://138081500"
			snd.PlaybackSpeed = 1.35
		elseif kind == "cannon" then
			snd.SoundId = "rbxassetid://138090596"
			snd.Volume = 0.55
			snd.PlaybackSpeed = 0.82
		elseif kind == "ricochet" then
			snd.SoundId = "rbxassetid://12222084"
			snd.PlaybackSpeed = 1.45
		elseif kind == "order" then
			snd.SoundId = "rbxassetid://6895079853"
			snd.PlaybackSpeed = 1.15
		elseif kind == "radio" then
			snd.SoundId = "rbxassetid://12222253"
			snd.Volume = 0.45
		else
			snd.SoundId = "rbxassetid://6895079853"
		end
		snd.Parent = SoundService
		snd:Play()
		Debris:AddItem(snd, 2.0)
	end)
end

-- ============================================================================
-- 2. ESTADO DEL CLIENTE (RTS + TÁCTICO + DIRECT CONTROL)
-- ============================================================================
local state = {
	missionId = "usa_normandy",
	missionTitle = "USA 1: Omaha Beachhead — Sector Charlie",
	playerFaction = "USA",
	enemyFaction = "GER",
	elapsedTime = 0,
	teamMp = { [0] = 420, [1] = 420 },
	teamVp = { [0] = 500, [1] = 500 },
	reinfCooldowns = {},
	playerBotMode = "OFF",
	flags = {},
	units = {},
	unitsById = {},

	selectedUnitIds = {} :: { [number]: boolean },
	directControlUnitId = nil :: number?,
	activeReinfTab = "ACTIVE", -- "ACTIVE" | "USA" | "GER" | "ENG" | "RUS" | "JAP"
	missionModalOpen = false,

	-- Modo de orden táctica para clic izquierdo ("AUTO" = seleccionar con clic izq / ordenar con clic der;
	-- "MOVE" = clic izq o der mueve; "ATTACK" = clic izq o der ataca)
	commandMode = "AUTO", -- "AUTO" | "MOVE" | "ATTACK"

	-- Cámara RTS Orbital
	camFocus = Vector3.new(-48, 0, 0),
	camYaw = 0,
	camPitch = math.rad(50),
	camDist = 96,

	-- Cámara Direct Control (independiente del cursor para evitar bucle de giro)

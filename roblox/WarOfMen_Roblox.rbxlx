		waterColor = Color3.fromRGB(38, 108, 138),
		ambientColor = Color3.fromRGB(136, 148, 142),
		startMp = 400,
		flags = {
			{ id = "flag_west", name = "Shuri Cave Ridge", pos = Vector3.new(-95, 0, -15), initialOwner = 0 },
			{ id = "flag_center", name = "Sugar Loaf Hill", pos = Vector3.new(0, 0, 0), initialOwner = -1 },
			{ id = "flag_east", name = "Marine Landing Causeway", pos = Vector3.new(95, 0, 15), initialOwner = 1 },

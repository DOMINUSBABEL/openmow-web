function WarOfMenCatalog.getMissionById(missionId: string): MissionDef
	for _, m in ipairs(WarOfMenCatalog.MISSIONS) do
		if m.id == missionId then
			return m
		end
	end
	return WarOfMenCatalog.MISSIONS[1]
end

function WarOfMenCatalog.getReinforcementsForFaction(faction: FactionId): { ReinforcementDef }
	local out = {}
	for _, r in ipairs(WarOfMenCatalog.REINFORCEMENTS) do
		if r.faction == faction then
			table.insert(out, r)
		end
	end
	return out
end

function WarOfMenCatalog.getPenetrationAtDistance(weapon: WeaponDef, distStuds: number): number
	local p = weapon.penetration
	-- En nuestro campo de batalla 1 metro ≈ 2.2 studs
	local distMeters = math.max(1, distStuds / 2.2)
	if distMeters <= 10 then
		return p.d10
	elseif distMeters <= 50 then
		local t = (distMeters - 10) / 40
		return p.d10 + (p.d50 - p.d10) * t
	elseif distMeters <= 100 then
		local t = (distMeters - 50) / 50
		return p.d50 + (p.d100 - p.d50) * t
	else
		local t = math.clamp((distMeters - 100) / 100, 0, 1)
		return p.d100 + (p.d200 - p.d100) * t
	end
end

return WarOfMenCatalog
